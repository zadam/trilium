// The mermaid "dispatcher" grammar detects the diagram type from the first
// meaningful line and emits a single node for it. The main mermaidLanguage then
// uses parseMixed to hand that node's range to the matching sub-diagram parser.
@top MermaidDiagram {
  preDiagramLine* (
    PieDiagram |
    MindmapDiagram |
    FlowchartDiagram |
    SequenceDiagram |
    JourneyDiagram |
    RequirementDiagram |
    GanttDiagram |
    TimelineDiagram |
    QuadrantDiagram |
    SankeyDiagram |
    XYChartDiagram |
    PacketDiagram |
    KanbanDiagram |
    BlockDiagram |
    ArchitectureDiagram |
    ClassDiagram |
    StateDiagram |
    ERDiagram |
    GitDiagram |
    C4Diagram
  )
}

@skip { space }

@tokens {
  space { $[ \t\r]+ }
}

@external tokens diagramText from "./tokens" {
  preDiagramLine,
  PieDiagram,
  MindmapDiagram,
  FlowchartDiagram,
  SequenceDiagram,
  JourneyDiagram,
  RequirementDiagram,
  GanttDiagram,
  TimelineDiagram,
  QuadrantDiagram,
  SankeyDiagram,
  XYChartDiagram,
  PacketDiagram,
  KanbanDiagram,
  BlockDiagram,
  ArchitectureDiagram,
  ClassDiagram,
  StateDiagram,
  ERDiagram,
  GitDiagram,
  C4Diagram
}
